# Postgres connection for the api and worker (required). App Platform injects this from the attached database.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/monitor?sslmode=disable
# api or worker
MODE=api
# api only
PORT=8080
# Per-target check cadence, clamped to 10s-30s
POLL_INTERVAL=15s
# Per HTTP check
CHECK_TIMEOUT=5s
# Semaphore size per worker; also the claim batch size
MAX_CONCURRENT_CHECKS=20
# Fallback webhook when a target has none (empty = log only)
DEFAULT_WEBHOOK_URL=
# Local only: store integration tests run against this and skip when unset
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/monitor?sslmode=disable
# Local only: doctl reads this if you have not run `doctl auth init`; never commit a real token
DIGITALOCEAN_ACCESS_TOKEN=
